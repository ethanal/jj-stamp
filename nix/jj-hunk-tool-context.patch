-
+use anyhow::{Context, Result};
+use git_surgeon::diff::DiffHunk;
+
+/// Build the same patch for preview and the external jj diff tool. Selection is
+/// resolved against the original hunk: never change its listing or line IDs.
+pub fn build_selected_patch(
+    hunk: &DiffHunk,
+    ranges: &[(usize, usize)],
+    reverse: bool,
+) -> Result<String> {
+    let mut selected = if !ranges.is_empty() {
+        git_surgeon::patch::slice_hunk_multi(hunk, ranges, reverse)?
+    } else if reverse {
+        git_surgeon::patch::slice_hunk(hunk, 1, hunk.lines.len(), true)?
+    } else {
+        hunk.clone()
+    };
+    if !ranges.is_empty() {
+        trim_outer_context(&mut selected, &hunk.header)?;
+    }
+    Ok(git_surgeon::patch::build_patch(&selected))
+}
+
+/// Neutralized deletions/additions can leave e.g. 16 leading context lines and
+/// only 3 trailing ones. GNU patch interprets unequal context as a BOF/EOF hint
+/// and can reject an exact match in the middle of a file, even with fuzz zero.
+/// Keep equal outer context (at most the usual 3 lines); preserve all changes
+/// and all internal context. At a boundary this can require zero outer context.
+fn trim_outer_context(hunk: &mut DiffHunk, original_header: &str) -> Result<()> {
+    let changed = |line: &String| line.starts_with('+') || line.starts_with('-');
+    let Some(first) = hunk.lines.iter().position(changed) else {
+        return Ok(());
+    };
+    let last = hunk.lines.iter().rposition(changed).unwrap();
+    let trailing = hunk.lines[last + 1..]
+        .iter()
+        .filter(|line| line.starts_with(' '))
+        .count();
+    let context = first.min(trailing).min(3);
+    let removed = first - context;
+    let mut end = last + 1;
+    // A no-newline marker belongs to the preceding line, not to context.
+    let mut kept = 0;
+    while end < hunk.lines.len() {
+        if hunk.lines[end].starts_with(' ') {
+            if kept == context {
+                break;
+            }
+            kept += 1;
+        }
+        end += 1;
+    }
+    hunk.lines = hunk.lines[removed..end].to_vec();
+
+    let (ranges, label) = original_header
+        .strip_prefix("@@ ")
+        .and_then(|header| header.split_once(" @@"))
+        .context("invalid hunk header")?;
+    let mut ranges = ranges.split_whitespace();
+    let old = ranges.next().context("missing old range")?;
+    let new = ranges.next().context("missing new range")?;
+    let old_count = hunk
+        .lines
+        .iter()
+        .filter(|l| l.starts_with([' ', '-']))
+        .count();
+    let new_count = hunk
+        .lines
+        .iter()
+        .filter(|l| l.starts_with([' ', '+']))
+        .count();
+    let old_start = trimmed_start(old, removed, old_count)?;
+    let new_start = trimmed_start(new, removed, new_count)?;
+    hunk.header = format!("@@ -{old_start},{old_count} +{new_start},{new_count} @@{label}");
+    Ok(())
+}
+
+fn trimmed_start(range: &str, removed: usize, count: usize) -> Result<usize> {
+    let (start, original_count) = range[1..].split_once(',').unwrap_or((&range[1..], "1"));
+    let start: usize = start.parse()?;
+    let original_count: usize = original_count.parse()?;
+    // Unified diff zero-length ranges name the line BEFORE an insertion, unlike
+    // nonempty ranges. Convert to a line position, advance, then convert back.
+    Ok(start + usize::from(original_count == 0) + removed - usize::from(count == 0))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    fn side(lines: &[String], new: bool) -> String {
+        lines
+            .iter()
+            .filter_map(|line| {
+                line.strip_prefix(' ')
+                    .or_else(|| line.strip_prefix(if new { '+' } else { '-' }))
+            })
+            .map(|line| format!("{line}\n"))
+            .collect()
+    }
+
+    fn apply(input: &str, patch: &str, reverse: bool) -> std::process::Output {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::write(dir.path().join("file.txt"), input).unwrap();
+        let mut command = Command::new("patch");
+        // Regression must not be hidden by GNU patch's default fuzz of 2.
+        command.args(["-p1", "--batch", "--fuzz=0"]);
+        if reverse {
+            command.arg("--reverse");
+        }
+        let mut child = command
+            .current_dir(dir.path())
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        child
+            .stdin
+            .take()
+            .unwrap()
+            .write_all(patch.as_bytes())
+            .unwrap();
+        let mut output = child.wait_with_output().unwrap();
+        if output.status.success() {
+            assert!(
+                !String::from_utf8_lossy(&output.stdout).contains("offset"),
+                "{output:?}"
+            );
+            output.stdout = std::fs::read(dir.path().join("file.txt")).unwrap_or_default();
+        }
+        output
+    }
+
+    fn fixture(leading: usize, trailing: usize, prefix: usize) -> DiffHunk {
+        let mut lines: Vec<String> = (0..leading).map(|i| format!(" before {i}")).collect();
+        lines.extend((0..14).map(|i| format!("-old {i}")));
+        lines.extend((0..14).map(|i| format!("+new {i}")));
+        lines.extend((0..trailing).map(|i| format!(" after {i}")));
+        let count = leading + 14 + trailing;
+        DiffHunk {
+            file: "file.txt".into(),
+            old_file: "file.txt".into(),
+            new_file: "file.txt".into(),
+            file_header: "--- a/file.txt\n+++ b/file.txt".into(),
+            header: format!(
+                "@@ -{},{} +{},{} @@ function label",
+                prefix + 1,
+                count,
+                prefix + 1,
+                count
+            ),
+            lines,
+            unsupported_metadata: None,
+        }
+    }
+
+    #[test]
+    fn sliced_context_applies_exactly_forward_and_reverse() {
+        // Middle of file, BOF, EOF, whole file, and short boundary context.
+        for (leading, trailing, prefix, suffix) in [
+            (3, 3, 5, 5),
+            (1, 1, 5, 5),
+            (0, 0, 5, 5),
+            (0, 3, 0, 5),
+            (3, 0, 5, 0),
+            (0, 0, 0, 0),
+            (1, 2, 0, 0),
+        ] {
+            let hunk = fixture(leading, trailing, prefix);
+            let before = (0..prefix)
+                .map(|i| format!("prefix {i}\n"))
+                .collect::<String>();
+            let after = (0..suffix)
+                .map(|i| format!("suffix {i}\n"))
+                .collect::<String>();
+            let ids = crate::diff::assign_ids(std::slice::from_ref(&hunk));
+            let id = ids[0].0.clone();
+            let original = format!("{:?}", hunk);
+            for picks in [vec![0], vec![13], vec![0, 13], vec![6, 8]] {
+                // Both a replacement and one-sided insertions/deletions. At
+                // boundaries the latter produce zero-length header ranges.
+                for kind in ["both", "delete", "add"] {
+                    let mut ranges = Vec::new();
+                    for i in &picks {
+                        if kind != "add" {
+                            ranges.push((leading + i + 1, leading + i + 1));
+                        }
+                        if kind != "delete" {
+                            ranges.push((leading + i + 15, leading + i + 15));
+                        }
+                    }
+                    for reverse in [false, true] {
+                        let sliced =
+                            git_surgeon::patch::slice_hunk_multi(&hunk, &ranges, reverse).unwrap();
+                        let patch = build_selected_patch(&hunk, &ranges, reverse).unwrap();
+                        let trimmed = crate::diff::parse_diff(&patch).remove(0);
+                        let changes = |h: &DiffHunk| {
+                            h.lines
+                                .iter()
+                                .filter(|l| l.starts_with(['+', '-']))
+                                .cloned()
+                                .collect::<Vec<_>>()
+                        };
+                        assert_eq!(changes(&trimmed), changes(&sliced));
+                        assert!(trimmed.header.ends_with("@@ function label"));
+                        let input = format!("{before}{}{after}", side(&hunk.lines, reverse));
+                        let expected = format!("{before}{}{after}", side(&sliced.lines, !reverse));
+                        let output = apply(&input, &patch, reverse);
+                        assert!(
+                            output.status.success(),
+                            "{kind} {picks:?} reverse={reverse}\n{patch}\n{output:?}"
+                        );
+                        assert_eq!(String::from_utf8(output.stdout).unwrap(), expected);
+                        let combined = crate::tool::build_combined_patch(
+                            &[(&id, &hunk, ranges.clone())],
+                            reverse,
+                        )
+                        .unwrap();
+                        assert_eq!(combined, patch, "mutation and preview must agree");
+                    }
+                }
+            }
+            assert_eq!(format!("{:?}", hunk), original);
+            assert_eq!(
+                crate::diff::assign_ids(std::slice::from_ref(&hunk))[0].0,
+                id
+            );
+        }
+    }
+
+    #[test]
+    fn zero_length_original_ranges_and_trimmed_anchors() {
+        assert_eq!(trimmed_start("-10,4", 2, 0).unwrap(), 11);
+        assert_eq!(trimmed_start("+0,0", 0, 3).unwrap(), 1);
+        assert_eq!(trimmed_start("-0,0", 0, 0).unwrap(), 0);
+        assert_eq!(trimmed_start("+7", 0, 0).unwrap(), 6);
+        for addition in [true, false] {
+            let mut hunk = fixture(0, 0, 0);
+            hunk.lines = (0..4)
+                .map(|i| format!("{}line {i}", if addition { '+' } else { '-' }))
+                .collect();
+            hunk.header = if addition {
+                "@@ -0,0 +1,4 @@"
+            } else {
+                "@@ -1,4 +0,0 @@"
+            }
+            .into();
+            for reverse in [false, true] {
+                let ranges = [(2, 3)];
+                let sliced = git_surgeon::patch::slice_hunk_multi(&hunk, &ranges, reverse).unwrap();
+                let patch = build_selected_patch(&hunk, &ranges, reverse).unwrap();
+                let output = apply(&side(&hunk.lines, reverse), &patch, reverse);
+                assert!(output.status.success(), "{patch}\n{output:?}");
+                assert_eq!(
+                    String::from_utf8(output.stdout).unwrap(),
+                    side(&sliced.lines, !reverse)
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn regression_was_false_eof_not_fuzzy_content() {
+        let hunk = fixture(3, 3, 5);
+        for (ranges, reverse) in [([(17, 17)], false), ([(31, 31)], true)] {
+            let sliced = git_surgeon::patch::slice_hunk_multi(&hunk, &ranges, reverse).unwrap();
+            let input = format!(
+                "prefix\nprefix\nprefix\nprefix\nprefix\n{}suffix\n",
+                side(&hunk.lines, reverse)
+            );
+            let broken = git_surgeon::patch::build_patch(&sliced);
+            assert!(
+                !apply(&input, &broken, reverse).status.success(),
+                "fixture must reproduce upstream failure: reverse={reverse} {ranges:?}\n{broken}"
+            );
+            let fixed = build_selected_patch(&hunk, &ranges, reverse).unwrap();
+            assert!(apply(&input, &fixed, reverse).status.success());
+            // A real context mismatch still fails with zero fuzz.
+            let bad = input
+                .replace("before 2", "wrong context")
+                .replace("after 0", "wrong context");
+            assert!(!apply(&bad, &fixed, reverse).status.success());
+        }
+    }
+}
