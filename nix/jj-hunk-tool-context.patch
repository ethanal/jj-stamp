+#[test]
+fn partial_squash_with_asymmetric_neutralized_context() {
+    // Selecting the last deletion used to produce 16 leading/3 trailing
+    // context lines and fail despite an exact match, because text follows it.
+    // Selecting the first exercises the opposite asymmetry as well.
+    for selected in [0, 13] {
+        let repo = TestRepo::new();
+        let prefix = (0..8).map(|i| format!("prefix {i}\n")).collect::<String>();
+        let suffix = (0..8).map(|i| format!("suffix {i}\n")).collect::<String>();
+        let old = (0..14).map(|i| format!("old {i}\n")).collect::<String>();
+        let new = (0..14).map(|i| format!("new {i}\n")).collect::<String>();
+        repo.commit_file("file.txt", &format!("{prefix}{old}{suffix}"));
+        repo.write_file("file.txt", &format!("{prefix}{new}{suffix}"));
+        let listing = repo.tool_ok(&["hunks"]);
+        let id = repo.get_single_hunk_id(&[]);
+        let row = |text: &str| {
+            listing
+                .lines()
+                .find_map(|line| {
+                    let (number, content) = line.split_once(':')?;
+                    (content == text).then(|| number.trim().parse::<usize>().unwrap())
+                })
+                .unwrap()
+        };
+        let removed = row(&format!("-old {selected}"));
+        let spec = format!("{id}:{removed}");
+        let patch = repo.tool_ok(&["patch", &spec]);
+        assert_eq!(
+            patch
+                .lines()
+                .filter(|l| l.starts_with('-') && !l.starts_with("---"))
+                .collect::<Vec<_>>(),
+            vec![format!("-old {selected}")]
+        );
+        assert!(
+            !patch
+                .lines()
+                .any(|l| l.starts_with('+') && !l.starts_with("+++"))
+        );
+        assert_eq!(
+            repo.tool_ok(&["hunks"]),
+            listing,
+            "preview must not alter selection IDs or ranges"
+        );
+        repo.tool_ok(&[
+            "squash",
+            &spec,
+            "--use-destination-message",
+            "--keep-emptied",
+        ]);
+        let expected = format!(
+            "{prefix}{}{suffix}",
+            old.replace(&format!("old {selected}\n"), "")
+        );
+        assert_eq!(repo.jj(&["file", "show", "-r", "@-", "file.txt"]), expected);
+        assert_eq!(repo.read_file("file.txt"), format!("{prefix}{new}{suffix}"));
+    }
+}
