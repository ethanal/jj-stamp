[Unit]
Description=Fold — interactive jj code review
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/jj-review-web
Environment=PATH=/home/exedev/.local/bin:/home/exedev/.cargo/bin:/home/exedev/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=8000
Environment=NODE_ENV=production
ExecStart=/home/exedev/node/bin/node --import tsx web.ts
KillMode=mixed
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
